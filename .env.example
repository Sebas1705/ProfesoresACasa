# Copy to .env (never commit it) and fill in your own values.
# Password of the HTTPS keystore used by both web replicas (any value; the keystore is
# generated with it on first start if certs/keystore.jks does not exist).
SSL_KEYSTORE_PASSWORD=change-me
# Gmail account the email service sends from, and its 16-character App Password.
MAIL_ORIGIN=your.address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
